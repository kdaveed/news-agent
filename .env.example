# Generate once: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
NEWSALERT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
NEWSALERT_DATABASE_URL=sqlite:///./data/newsalert.db
# Set true when serving over HTTPS.
NEWSALERT_COOKIE_SECURE=false

# Local Mailpit. In Compose, use the Mailpit service name instead of 127.0.0.1.
NEWSALERT_SMTP_HOST=127.0.0.1
NEWSALERT_SMTP_PORT=1025
NEWSALERT_SMTP_FROM=alerts@example.com
NEWSALERT_SMTP_SECURITY=none
# Production SMTP can use starttls or tls, plus both credentials:
# NEWSALERT_SMTP_USERNAME=
# NEWSALERT_SMTP_PASSWORD=
NEWSALERT_DELIVERY_MAX_ATTEMPTS=3
NEWSALERT_DELIVERY_RETRY_SECONDS=30
NEWSALERT_DISPATCHER_POLL_SECONDS=5
